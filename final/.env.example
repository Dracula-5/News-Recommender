# Copy to .env and adjust as needed. All variables are optional — sane
# defaults are baked into config.py.

NEUROFEED_ENV=development
NEUROFEED_LOG_LEVEL=INFO

# Override to point at a different SQLite file — tests/conftest.py does
# this to isolate the test DB from the real dev database.
# NEUROFEED_DB_PATH=data/news_recommender.sqlite
# NEUROFEED_AUTH_DB_PATH=data/auth.sqlite

# Comma-separated list in production, e.g. https://neurofeed.example.com
NEUROFEED_CORS_ORIGINS=*

# Set to true to start the OpenCV/MediaPipe webcam attention worker
# automatically on server startup (requires a camera on the host).
NEUROFEED_ENABLE_WEBCAM_ATTENTION=false

NEUROFEED_COLD_START_INTERACTION_THRESHOLD=5
NEUROFEED_MMR_LAMBDA=0.75
NEUROFEED_MAX_CACHED_AGENTS=500

NEUROFEED_CACHE_TTL_SECONDS=30
NEUROFEED_RATE_LIMIT_REQUESTS=120
NEUROFEED_RATE_LIMIT_WINDOW_SECONDS=60

# Stricter limiter applied only to /auth/signup and /auth/login.
NEUROFEED_AUTH_RATE_LIMIT_REQUESTS=10
NEUROFEED_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Per-account login lockout after repeated failures (see login_throttle.py).
NEUROFEED_LOGIN_MAX_FAILURES=5
NEUROFEED_LOGIN_FAILURE_WINDOW_SECONDS=300
NEUROFEED_LOGIN_LOCKOUT_SECONDS=60
